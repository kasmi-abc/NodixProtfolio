# Copy to .env.local and fill in after deploy.
# Production domain used by sitemap, robots and SEO metadata.
NEXT_PUBLIC_SITE_URL=https://nodix-protfolio.vercel.app

# ---- Real lead delivery: Telegram direct (recommended, no n8n needed) ----
# 1. Open @BotFather in Telegram → /newbot → copy the token below.
# 2. Open your bot, press START, then open https://api.telegram.org/bot<TOKEN>/getUpdates
#    and copy your numeric chat id (or use @userinfobot).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---- Optional: n8n forwarding (in addition to Telegram) ----
# New Workflow → Webhook Trigger (POST) → Telegram/WhatsApp/Email/Airtable nodes.
# N8N_WEBHOOK_URL=https://your-n8n.com/webhook/nodix-lead

# Public contact used for wa.me + mailto + Telegram buttons (no secret).
NEXT_PUBLIC_WHATSAPP_NUMBER=213655886880
NEXT_PUBLIC_CONTACT_EMAIL=kasmihaithem3@gmail.com
NEXT_PUBLIC_TELEGRAM_URL=https://t.me/nodix_core

# Demo video section (local file already in public/, override only if needed).
# NEXT_PUBLIC_DEMO_VIDEO_URL=/nodix-demo.mp4

# Analytics (optional, both auto-enabled when set):
# NEXT_PUBLIC_GA_ID=G-XXXXXXX
# NEXT_PUBLIC_PLAUSIBLE_DOMAIN=nodix-protfolio.vercel.app
